// Restoration Shop ERP — Prisma schema v1
// See .kilo/plans/1784938774840-restoration-shop-erp-plan.md for context.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// Auth / RBAC
// ----------------------------------------------------------------------------

enum Role {
  ADMIN
  SHOP_MANAGER
  PARTS_MANAGER
  TECHNICIAN
  FRONT_DESK
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          Role      @default(TECHNICIAN)
  // New accounts (including self-registered OAuth sign-ins) are inactive
  // until an Admin explicitly activates them via the admin user management
  // API. Seed/admin-created staff must set active: true explicitly.
  active        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  // Staff relations
  timeEntries          TimeEntry[]       @relation("TechTimeEntries")
  partConsumptions     PartConsumption[] @relation("TechPartConsumptions")
  approvedConsumptions PartConsumption[] @relation("ApproverPartConsumptions")
  assignedPhases       JobPhase[]        @relation("AssignedTech")
  auditLogs            AuditLog[]
  notifications        Notification[]

  // Customer relation
  customer Customer?

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ----------------------------------------------------------------------------
// Domain: Customer -> Vehicle -> Project -> JobPhase
// ----------------------------------------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  userId    String?  @unique // linked portal login, optional until invited
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicles Vehicle[]
  invoices Invoice[]
  payments Payment[]
}

model Vehicle {
  id         String   @id @default(cuid())
  customerId String
  year       Int?
  make       String
  model      String
  vin        String?
  color      String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([customerId])
}

enum ProjectStatus {
  ESTIMATE
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id               String        @id @default(cuid())
  vehicleId        String
  name             String
  status           ProjectStatus @default(ESTIMATE)
  shopRateOverride Decimal?      @db.Decimal(10, 2)
  startDate        DateTime?
  targetEndDate    DateTime?
  actualEndDate    DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  vehicle       Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  phases        JobPhase[]
  estimate      ProjectEstimate?
  billingCycles BillingCycle[]
  specialOrders SpecialOrder[]

  @@index([vehicleId])
  @@index([status])
}

enum PhaseStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

model JobPhase {
  id             String      @id @default(cuid())
  projectId      String
  name           String
  sequence       Int         @default(0)
  status         PhaseStatus @default(NOT_STARTED)
  assignedTechId String?
  estimatedHours Decimal?    @db.Decimal(10, 2)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTech     User?             @relation("AssignedTech", fields: [assignedTechId], references: [id], onDelete: SetNull)
  timeEntries      TimeEntry[]
  partConsumptions PartConsumption[]
  estimateLines    EstimateLine[]

  @@index([projectId])
  @@index([assignedTechId])
}

// ----------------------------------------------------------------------------
// Time Tracking
// ----------------------------------------------------------------------------

enum TimeEntryStatus {
  OPEN
  SUBMITTED
  APPROVED
  BILLED
  REJECTED
}

model TimeEntry {
  id             String          @id @default(cuid())
  jobPhaseId     String
  techId         String
  startTime      DateTime?
  endTime        DateTime?
  workDate       DateTime?
  manualHours    Decimal?        @db.Decimal(10, 2)
  notes          String?
  status         TimeEntryStatus @default(OPEN)
  billingCycleId String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  jobPhase     JobPhase      @relation(fields: [jobPhaseId], references: [id], onDelete: Cascade)
  tech         User          @relation("TechTimeEntries", fields: [techId], references: [id], onDelete: Cascade)
  billingCycle BillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: SetNull)

  @@index([jobPhaseId])
  @@index([techId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// Inventory & Parts
// ----------------------------------------------------------------------------

model Part {
  id               String   @id @default(cuid())
  sku              String   @unique
  description      String
  costPrice        Decimal  @db.Decimal(10, 2)
  sellingPrice     Decimal  @db.Decimal(10, 2)
  quantityOnHand   Int      @default(0)
  reorderThreshold Int      @default(0)
  location         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  consumptions  PartConsumption[]
  specialOrders SpecialOrderItem[]
}

enum ConsumptionStatus {
  PENDING
  APPROVED
  REJECTED
}

model PartConsumption {
  id                   String            @id @default(cuid())
  jobPhaseId           String
  partId               String?
  skuEntered           String
  quantity             Int
  techId               String
  status               ConsumptionStatus @default(PENDING)
  requiresApproval     Boolean           @default(false)
  approverId           String?
  sellingPriceLockedAt Decimal?          @db.Decimal(10, 2)
  overridePrice        Decimal?          @db.Decimal(10, 2)
  rejectionReason      String?
  billingCycleId       String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  jobPhase     JobPhase      @relation(fields: [jobPhaseId], references: [id], onDelete: Cascade)
  part         Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  tech         User          @relation("TechPartConsumptions", fields: [techId], references: [id], onDelete: Cascade)
  approver     User?         @relation("ApproverPartConsumptions", fields: [approverId], references: [id], onDelete: SetNull)
  billingCycle BillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: SetNull)

  @@index([jobPhaseId])
  @@index([status])
  @@index([techId])
}

enum SpecialOrderStatus {
  REQUESTED
  PO_SENT
  DELIVERED
  TRANSFERRED_TO_INVENTORY
  RETURNED
  CANCELLED
}

model SpecialOrder {
  id          String             @id @default(cuid())
  projectId   String
  vendorName  String
  poNumber    String?
  status      SpecialOrderStatus @default(REQUESTED)
  orderedAt   DateTime?
  deliveredAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  project Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items   SpecialOrderItem[]

  @@index([projectId])
  @@index([status])
}

model SpecialOrderItem {
  id             String   @id @default(cuid())
  specialOrderId String
  partId         String?
  description    String
  quantity       Int
  unitCost       Decimal  @db.Decimal(10, 2)
  sellingPrice   Decimal  @db.Decimal(10, 2)
  billingCycleId String?
  createdAt      DateTime @default(now())

  specialOrder SpecialOrder  @relation(fields: [specialOrderId], references: [id], onDelete: Cascade)
  part         Part?         @relation(fields: [partId], references: [id], onDelete: SetNull)
  billingCycle BillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: SetNull)

  @@index([specialOrderId])
}

// ----------------------------------------------------------------------------
// Quoting / Estimates
// ----------------------------------------------------------------------------

enum EstimateLineType {
  LABOR
  PART
  SPECIAL_ORDER
}

model ProjectEstimate {
  id           String    @id @default(cuid())
  projectId    String    @unique
  approvedAt   DateTime?
  approvedNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lines   EstimateLine[]
}

model EstimateLine {
  id                String           @id @default(cuid())
  estimateId        String
  jobPhaseId        String?
  type              EstimateLineType
  description       String
  estimatedQuantity Decimal          @db.Decimal(10, 2) // hours or part qty
  estimatedUnitCost Decimal          @db.Decimal(10, 2)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  estimate ProjectEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  jobPhase JobPhase?       @relation(fields: [jobPhaseId], references: [id], onDelete: SetNull)

  @@index([estimateId])
}

// ----------------------------------------------------------------------------
// Billing
// ----------------------------------------------------------------------------

model BillingCycle {
  id        String   @id @default(cuid())
  projectId String
  startDate DateTime
  endDate   DateTime
  invoiced  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  timeEntries       TimeEntry[]
  partConsumptions  PartConsumption[]
  specialOrderItems SpecialOrderItem[]
  invoice           Invoice?

  @@index([projectId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id             String        @id @default(cuid())
  billingCycleId String        @unique
  customerId     String
  invoiceNumber  String        @unique
  status         InvoiceStatus @default(DRAFT)
  subtotal       Decimal       @db.Decimal(10, 2)
  depositApplied Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  sentAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  billingCycle BillingCycle  @relation(fields: [billingCycleId], references: [id], onDelete: Cascade)
  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lineItems    InvoiceLine[]
  payments     Payment[]

  @@index([customerId])
}

enum InvoiceLineType {
  LABOR
  PART
  SPECIAL_ORDER
  DEPOSIT
}

model InvoiceLine {
  id          String          @id @default(cuid())
  invoiceId   String
  type        InvoiceLineType
  description String
  quantity    Decimal         @db.Decimal(10, 2)
  unitPrice   Decimal         @db.Decimal(10, 2)
  lineTotal   Decimal         @db.Decimal(10, 2)
  jobPhaseId  String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  CHECK
  CARD
  ACH
  OTHER
}

model Payment {
  id         String        @id @default(cuid())
  invoiceId  String
  customerId String
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  paidAt     DateTime      @default(now())
  reference  String?
  createdAt  DateTime      @default(now())

  invoice  Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([customerId])
}

model ShopSettings {
  id              String   @id @default("singleton")
  defaultShopRate Decimal  @default(95.00) @db.Decimal(10, 2)
  companyName     String   @default("Restoration Shop")
  // Atomically incremented to generate sequential invoice numbers without
  // scanning/counting the Invoice table inside the billing transaction.
  invoiceSequence Int      @default(0)
  updatedAt       DateTime @updatedAt
}
