# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restoration_erp?schema=public"

# NextAuth.js
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (staff login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend (transactional email: invoices, estimates, POs, customer magic-links)
RESEND_API_KEY=""
EMAIL_FROM="no-reply@example.com"

# Docker Compose Postgres credentials (production). Required — docker-compose.yml
# fails fast if these are unset rather than falling back to weak defaults.
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-to-a-strong-password"
POSTGRES_DB="restoration_erp"
