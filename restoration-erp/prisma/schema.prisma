generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SHOP_MANAGER
  PARTS_MANAGER
  TECHNICIAN
  FRONT_DESK
  CUSTOMER
}

enum ProjectStatus {
  ESTIMATING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  DELIVERED
}

enum JobPhaseStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum TimeEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum PartConsumptionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SpecialOrderStatus {
  DRAFT
  PO_SENT
  PARTIAL_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum EstimateStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  REVISED
}

enum NotificationType {
  APPROVAL_REQUIRED
  PHASE_UPDATE
  LOW_STOCK
  INVOICE_CREATED
  ESTIMATE_READY
  PO_UPDATE
  GENERAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(TECHNICIAN)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  timeEntries   TimeEntry[]
  consumptions  PartConsumption[]  @relation("RequestedBy")
  approvals     PartConsumption[]  @relation("ApprovedBy")
  estimates     ProjectEstimate[]  @relation("CreatedBy")
  invoices      Invoice[]          @relation("CreatedBy")
  assignments   JobPhaseAssignment[]
  notifications Notification[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicles  Vehicle[]
  projects  Project[]
  invoices  Invoice[]

  @@index([email])
  @@index([name])
}

model Vehicle {
  id          String   @id @default(cuid())
  customerId  String
  year        Int?
  make        String
  model       String
  vin         String?  @unique
  licensePlate String?
  color       String?
  mileage     Int?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  projects Project[]

  @@index([customerId])
  @@index([vin])
}

model Project {
  id              String        @id @default(cuid())
  customerId      String
  vehicleId       String
  title           String
  description     String?       @db.Text
  status          ProjectStatus @default(ESTIMATING)
  shopRate        Float?
  deposit         Float?        @default(0)
  startDate       DateTime?
  estimatedCompletion DateTime?
  actualCompletion    DateTime?
  priority        Int           @default(3)
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer    Customer     @relation(fields: [customerId], references: [id])
  vehicle     Vehicle      @relation(fields: [vehicleId], references: [id])
  phases      JobPhase[]
  estimates   ProjectEstimate[]
  billingCycles BillingCycle[]
  timeEntries TimeEntry[]
  consumptions PartConsumption[]
  specialOrders SpecialOrder[]
  invoices    Invoice[]

  @@index([customerId])
  @@index([vehicleId])
  @@index([status])
}

model JobPhase {
  id          String         @id @default(cuid())
  projectId   String
  name        String
  description String?        @db.Text
  status      JobPhaseStatus @default(PENDING)
  sortOrder   Int            @default(0)
  estimatedHours Float?
  actualHours   Float?       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments JobPhaseAssignment[]
  timeEntries TimeEntry[]
  consumptions PartConsumption[]

  @@index([projectId])
}

model JobPhaseAssignment {
  id        String   @id @default(cuid())
  jobId     String
  userId    String
  assignedAt DateTime @default(now())

  jobPhase JobPhase @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}

model TimeEntry {
  id            String          @id @default(cuid())
  userId        String
  projectId     String
  jobId         String?
  workDate      DateTime
  startTime     DateTime?
  endTime       DateTime?
  manualHours   Float?
  description   String?         @db.Text
  status        TimeEntryStatus @default(DRAFT)
  isChargeable  Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobPhase JobPhase? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([jobId])
  @@index([workDate])
}

model Part {
  id                String   @id @default(cuid())
  sku               String   @unique
  description       String
  category          String?
  costPrice         Float
  sellingPrice      Float
  quantity          Int      @default(0)
  reorderThreshold  Int      @default(5)
  location          String?
  vendor            String?
  notes             String?  @db.Text
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  consumptions  PartConsumption[]
  specialOrders SpecialOrder[]

  @@index([sku])
  @@index([category])
}

model PartConsumption {
  id                    String                @id @default(cuid())
  projectId             String
  jobId                 String
  partId                String?
  customDescription     String?
  quantity              Float
  unitPrice             Float?
  sellingPriceLockedAt  Float?
  status                PartConsumptionStatus @default(PENDING)
  requestedById         String
  approvedById          String?
  approvedAt            DateTime?
  rejectionReason       String?               @db.Text
  notes                 String?               @db.Text
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobPhase   JobPhase @relation(fields: [jobId], references: [id], onDelete: Cascade)
  part       Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  requestedBy User    @relation("RequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([projectId])
  @@index([jobId])
  @@index([status])
  @@index([requestedById])
}

model SpecialOrder {
  id              String             @id @default(cuid())
  projectId       String
  partId          String?
  description     String
  quantity        Float              @default(1)
  unitCost        Float
  sellingPrice    Float?
  poNumber        String?
  vendor          String?
  status          SpecialOrderStatus @default(DRAFT)
  orderedDate     DateTime?
  expectedDate    DateTime?
  deliveredDate   DateTime?
  trackingNumber  String?
  notes           String?            @db.Text
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([status])
}

model ProjectEstimate {
  id              String         @id @default(cuid())
  projectId       String
  title           String
  description     String?        @db.Text
  status          EstimateStatus @default(DRAFT)
  laborHours      Float          @default(0)
  laborRate       Float?
  partsTotal      Float          @default(0)
  specialOrdersTotal Float       @default(0)
  subtotal        Float          @default(0)
  taxRate         Float          @default(0)
  taxAmount       Float          @default(0)
  total           Float          @default(0)
  validUntil      DateTime?
  customerSignature String?
  signedAt        DateTime?
  notes           String?        @db.Text
  createdById     String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("CreatedBy", fields: [createdById], references: [id])
  lineItems EstimateLineItem[]

  @@index([projectId])
}

model EstimateLineItem {
  id          String  @id @default(cuid())
  estimateId  String
  type        String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float
  sortOrder   Int     @default(0)

  estimate ProjectEstimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model BillingCycle {
  id          String   @id @default(cuid())
  projectId   String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean  @default(false)
  closedAt    DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([projectId])
  @@index([startDate, endDate])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  projectId       String
  billingCycleId  String?
  customerId      String
  status          InvoiceStatus @default(DRAFT)
  laborTotal      Float         @default(0)
  partsTotal      Float         @default(0)
  specialOrdersTotal Float      @default(0)
  subtotal        Float         @default(0)
  taxRate         Float         @default(0)
  taxAmount       Float         @default(0)
  total           Float         @default(0)
  amountPaid      Float         @default(0)
  balance         Float         @default(0)
  dueDate         DateTime?
  sentAt          DateTime?
  paidAt          DateTime?
  notes           String?       @db.Text
  createdById     String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project      Project       @relation(fields: [projectId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  billingCycle BillingCycle? @relation(fields: [billingCycleId], references: [id], onDelete: SetNull)
  createdBy    User          @relation("CreatedBy", fields: [createdById], references: [id])
  lineItems    InvoiceLineItem[]
  payments     Payment[]

  @@index([projectId])
  @@index([invoiceNumber])
  @@index([status])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  type        String
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  total       Float
  phaseName   String?
  sortOrder   Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id            String   @id @default(cuid())
  invoiceId     String
  amount        Float
  method        String
  reference     String?
  receivedDate  DateTime
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String
  changes   String?  @db.Text
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
